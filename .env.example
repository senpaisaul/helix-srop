# ── LLM Provider ────────────────────────────────────────────────────────────
# GOOGLE_API_KEY is always required — embeddings (gemini-embedding-001) come
# from Google regardless of which chat model you pick.
GOOGLE_API_KEY=your-google-api-key-here
#
# Optional: chat path can be routed to Anthropic / OpenAI via LiteLLM by
# setting ANTHROPIC_API_KEY (or OPENAI_API_KEY) AND ADK_MODEL with a
# provider prefix below.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./helix_srop.db
# Postgres (for Postgres-compatible schema):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/helix_srop

# ── Vector Store ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
# LANCEDB_PATH=./lancedb
# PINECONE_API_KEY=...
# PINECONE_INDEX=helix-docs

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-in-prod     # used for JWT signing (extension E2)

# ── Model Selection ───────────────────────────────────────────────────────────
# Native Gemini: bare model name (e.g. gemini-2.5-flash, gemini-2.5-flash-lite)
# Anything else: provider prefix routes through LiteLLM
#   - anthropic/claude-sonnet-4-5      (highest routing accuracy, recommended)
#   - anthropic/claude-haiku-4-5       (faster, cheaper)
#   - openai/gpt-4o-mini
ADK_MODEL=anthropic/claude-sonnet-4-5

# ── Agent Timeouts ────────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
